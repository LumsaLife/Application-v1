# ---------------------------------------------------------------------------
# Lumsa — environment
#
# Copy to .env.local and fill in. Nothing here is optional unless it says so.
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# --- Supabase (required) ---------------------------------------------------
# Project Settings → Data API, and Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Bypasses row-level security. Server-only — never expose it to the browser,
# and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Claude (required) -----------------------------------------------------
# console.anthropic.com → API keys. Writes the meditation scripts.
ANTHROPIC_API_KEY=sk-ant-...

# --- Token encryption (required) -------------------------------------------
# Encrypts calendar refresh tokens before they touch the database.
# Generate with:  openssl rand -base64 32
# Rotating this invalidates every stored calendar connection — users reconnect.
ENCRYPTION_KEY=

# --- Cron (required) -------------------------------------------------------
# Shared secret for /api/cron/*. Vercel sends it as a bearer token automatically
# once this is set on the project.
# Generate with:  openssl rand -hex 32
CRON_SECRET=

# --- Text to speech (optional, strongly recommended) -----------------------
# Without a provider, playback falls back to the browser's Web Speech API, which
# works but sounds like a screen reader. Fine locally, not for a demo.
#
# elevenlabs | openai | none. Inferred from whichever key is set if omitted.
TTS_PROVIDER=elevenlabs

# ElevenLabs — the default, and what the voice settings are tuned for. It honours
# the <break> tags the prompt emits, which is what makes the pacing work.
ELEVENLABS_API_KEY=
# Defaults to "Sarah" (EXAVITQu4vr4xnSDxMaL) — calm and unhurried.
ELEVENLABS_VOICE_ID=

# OpenAI TTS — cheaper, but has no silence primitive, so break tags are stripped
# and the pacing flattens considerably.
OPENAI_API_KEY=

# --- Google Calendar (optional) --------------------------------------------
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# (Web application). Enable the Google Calendar API for the project first.
# Authorised redirect URI:
#   http://localhost:3000/api/calendar/google/callback
#   https://your-domain.com/api/calendar/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Microsoft / Outlook / Teams (optional) --------------------------------
# portal.azure.com → Microsoft Entra ID → App registrations → New registration.
# Add delegated permissions: Calendars.Read, User.Read, offline_access.
# Redirect URI (type "Web"):
#   http://localhost:3000/api/calendar/microsoft/callback
#   https://your-domain.com/api/calendar/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" accepts both personal and work/school accounts. Set a tenant ID to
# restrict to one organisation.
MICROSOFT_TENANT_ID=common

# --- Email (optional) ------------------------------------------------------
# resend.com → API keys. Without this the daily reminder cron no-ops.
RESEND_API_KEY=
EMAIL_FROM="Lumsa <hello@yourdomain.com>"

# --- App -------------------------------------------------------------------
# Used to build OAuth redirect URIs and links in email. On Vercel this is
# derived from VERCEL_URL automatically, but set it explicitly for a custom
# domain — OAuth redirect URIs must match exactly.
NEXT_PUBLIC_APP_URL=http://localhost:3000
