{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "framework": "nextjs",

  "crons": [
    {
      "path": "/api/cron/generate",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/audio",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/remind",
      "schedule": "0 * * * *"
    }
  ]
}
